# Alternative to /var/ipax/conf/ssl/default.settings, for a certificate with custom file names.
# Mount the files in /var/ipax/certs/ and include this file instead of default.settings.
listen 443 ssl;
ssl_certificate           /var/ipax/certs/wildcard_identicum_com.cer;
ssl_certificate_key       /var/ipax/certs/wildcard_identicum_com.key;

ssl_session_cache  builtin:1000  shared:SSL:10m;
ssl_protocols  TLSv1.2 TLSv1.3;
ssl_ciphers HIGH:!aNULL:!eNULL:!EXPORT:!CAMELLIA:!DES:!MD5:!PSK:!RC4;
ssl_prefer_server_ciphers on;
